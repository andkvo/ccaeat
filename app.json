{
  "expo": {
    "name": "ccaeat-expo",
    "slug": "ccaeat-expo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.americanappworks.ccalimitedpreptimer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Limited Prep Timer",
      "shortName": "LPT",
      "description": "Competitive debate limited prep timer with audio cues for CCA.",
      "themeColor": "#0f172a",
      "backgroundColor": "#0f172a",
      "lang": "en"
    },
    "extra": {
      "eas": {
        "projectId": "989a7d57-de34-4e7b-8b82-185904d6b01a"
      }
    }
  }
}
